        puts "DEFER #{date}: needs manual review (run with INCLUDE_REVIEW=true to apply)"
        deferred += 1
        next
      end

      show = Show.find_by(date:)
      if show.nil?
        puts "SKIP #{date}: show not found"
        skipped += 1
        next
      end

      current = show.tracks.order(:position).pluck(:id)
      if current.sort != ids.sort
        puts "SKIP #{date}: track IDs don't match expected set " \
             "(missing: #{(ids - current).inspect}, unexpected: #{(current - ids).inspect})"
        skipped += 1
        next
      end
      if current == ids
        puts "OK   #{date}: already in desired order"
        ok += 1
        next
      end

